          </mxGeometry>
        </mxCell>
        <mxCell id="listen-upload" value="提交发送" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0D9488;fontColor=#0D9488;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="listen-worker" target="upload-ws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="upload-server-edge" value="Opus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0D9488;fontColor=#0D9488;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="upload-ws" target="upload-server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="capture-note" value="Idle 和 Listening 按状态交替消费录音队列，不会同时处理这一路录音。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontColor=#475569;fontSize=17;fontStyle=0;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1350" y="230" width="435" height="90" as="geometry" />
        </mxCell>
        <mxCell id="play-band" value="&lt;b&gt;② 服务器回复音频 → 解码 → 扬声器播放　（从右向左读）&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1790" height="260" as="geometry" />
        </mxCell>
        <mxCell id="speaker" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;扬声器&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;音频输出设备&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="655" width="180" height="115" as="geometry" />
        </mxCell>
        <mxCell id="play-cb" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;PortAudio 播放回调&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;playCallback()&lt;br&gt;取 PCM → 填充 outputBuffer&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="645" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="play-queue" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;playbackQueue&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;待播放 PCM 队列&lt;br&gt;mutex 保护&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="645" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="download-ws" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;WebSocket 线程 / WSHandler&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;on_message() → ws_msg_handle()&lt;br&gt;二进制协议解包 → Opus 解码 → 入队&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="635" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="download-server" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;Server&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;TTS 音频&lt;br&gt;外部进程&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1650" y="655" width="150" height="115" as="geometry" />
        </mxCell>
        <mxCell id="download" value="Opus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0D9488;fontColor=#0D9488;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="download-server" target="download-ws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="decode-queue" value="PCM 入队" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0D9488;fontColor=#0D9488;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="download-ws" target="play-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="queue-play" value="取帧" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8B5CF6;fontColor=#8B5CF6;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="play-queue" target="play-cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="play-speaker" value="PCM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8B5CF6;fontColor=#8B5CF6;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="play-cb" target="speaker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="event-band" value="&lt;b&gt;③ 事件入队 → 状态机处理 → 管理状态和线程&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1790" height="320" as="geometry" />
        </mxCell>
        <mxCell id="event-producers" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;事件生产者（已有线程）&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;Idle：wake_detected&lt;br&gt;Speaking：speaking_end / dialogue_end&lt;br&gt;WebSocket：ASR / VAD / 首包 / 故障&lt;br&gt;启动或外部 Stop() 调用也可投递事件&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#65A30D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="950" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="event-queue" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;eventQueue_&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;EventQueue&amp;lt;int&amp;gt;&lt;br&gt;mutex + 条件变量&lt;br&gt;共享事件队列&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="570" y="970" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="state-consumer" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;状态机事件线程&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;每 100 ms 检查队列&lt;br&gt;Dequeue() → HandleEvent()&lt;br&gt;查询状态转换表 → ChangeState()&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="940" y="960" width="350" height="170" as="geometry" />
        </mxCell>
        <mxCell id="state-callbacks" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;Enter / Exit 回调&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;在状态机线程内同步执行&lt;br&gt;旧状态 Exit()：停止并 join 工作线程&lt;br&gt;新状态 Enter()：按需启动工作线程&lt;br&gt;录音 / 播放流也在此启动或停止&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1400" y="950" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="event-enqueue" value="Enqueue()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="event-producers" target="event-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="event-dequeue" value="Dequeue()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="event-queue" target="state-consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="event-change" value="状态切换" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3B82F6;fontColor=#3B82F6;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="state-consumer" target="state-callbacks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flags-band" value="&lt;b&gt;④ 播放完成判断：标志 + 播放队列 → 状态事件&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="1790" height="300" as="geometry" />
        </mxCell>
        <mxCell id="flags-ws" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;WebSocket 消息回调&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;tts.end → TTS 完成&lt;br&gt;chat.dialogue.end → 对话完成&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1320" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="shared-flags" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;Application 共享标志&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;tts_completed_&lt;br&gt;dialogue_completed_&lt;br&gt;当前实现为普通 bool 成员&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="1310" width="350" height="165" as="geometry" />
        </mxCell>
        <mxCell id="speaking-check" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;Speaking 工作线程&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;每 500 ms 检查 TTS 完成标志&lt;br&gt;同时检查 playbackQueue 是否为空&lt;br&gt;满足后再等 500 ms，并投递事件&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#65A30D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="970" y="1310" width="380" height="165" as="geometry" />
        </mxCell>
        <mxCell id="finish-event" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;eventQueue_（同上）&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;对话未结束：speaking_end&lt;br&gt;对话已结束：dialogue_end&lt;br&gt;由状态机继续处理&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1470" y="1310" width="330" height="165" as="geometry" />
        </mxCell>
        <mxCell id="flags-write" value="写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0D9488;fontColor=#0D9488;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flags-ws" target="shared-flags">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flags-read" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#65A30D;fontColor=#65A30D;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="shared-flags" target="speaking-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flags-event" value="Enqueue()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="speaking-check" target="finish-event">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;阅读说明&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;Speaking 工作线程只检查何时播完；实际输出由 PortAudio 回调负责。网络音频解码在 WebSocket 线程中，没有额外的解码线程。&lt;br&gt;本图展示现有代码的访问关系；共享标志为普通 bool，图中的箭头不表示这些跨线程访问已经具备同步保证。&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1960" width="1790" height="135" as="geometry" />
        </mxCell>
        <mxCell id="flow-sources" value="源码依据：Audio/AudioProcess.cc · Application/WS_Handler.cc · Application/Application.cc · Application/UserStates/*.cc · Events/EventQueue.h" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontColor=#475569;fontSize=15;fontStyle=0;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2130" width="1790" height="35" as="geometry" />
        </mxCell>
        <mxCell id="gui-band" value="&lt;b&gt;⑤ LVGL 主线程经 C 接口读取状态与意图　（同进程访问）&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1570" width="1790" height="345" as="geometry" />
        </mxCell>
        <mxCell id="gui-shared" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;Client 共享数据&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;状态机线程更新当前状态&lt;br&gt;WebSocket 线程将 function_call&lt;br&gt;消息放入 IntentQueue_&lt;br&gt;对象与队列仍属于同一 Application&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1670" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gui-getters" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;C 接口层 · 在 GUI 主线程执行&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;get_aichat_app_state() → app-&amp;gt;getState()&lt;br&gt;get_aichat_app_intent() → IntentQueue_ 出队&lt;br&gt;将 C++ 数据转换成 C 可用的返回值 / 结构体&lt;br&gt;没有创建额外的查询线程或进程&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="590" y="1670" width="490" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gui-timers" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.25&quot;&gt;LVGL / GUI 主线程 · 定时回调&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:8px&quot;&gt;_ChatBotTimer_cb()：250 ms 查询状态并更新表情&lt;br&gt;_ChatBotMoveTimer_cb()：500 ms 获取意图并控制运动&lt;br&gt;均由 main() 中的 lv_timer_handler() 调度执行&lt;br&gt;关闭页面的手势处理通过 stop_ai_chat() 发出停止请求&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1670" width="600" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gui-data-return" value="读取数据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gui-shared" target="gui-getters">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gui-query-return" value="返回结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3B82F6;fontColor=#3B82F6;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gui-getters" target="gui-timers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>