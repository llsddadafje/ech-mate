          </mxGeometry>
        </mxCell>
        <mxCell id="queue-listen" value="Listening 时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#65A30D;fontColor=#65A30D;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="record-queue" target="listen-worker">
          <mxGeometry relative="1" as="geometry">
