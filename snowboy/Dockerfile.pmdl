# Seasalt 的生成库要求 Ubuntu 16.04 / Python 2.7。
# 复用已下载的源码，只安装离线生成模型所需依赖，不需要 PyAudio。
FROM ubuntu:16.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates python2.7 libpython2.7 python-pip \
    && python2.7 -m pip install --no-cache-dir \
        pip==20.3.4 setuptools==44.1.1 wheel==0.37.1 \
    && python2.7 -m pip install --no-cache-dir \
        numpy==1.16.6 scipy==1.2.3 \
    && rm -rf /var/lib/apt/lists/*

COPY seasalt-src/ /opt/snowboy/
WORKDIR /opt/snowboy/examples/Python

# 构建时验证原生生成库能加载，以及中文/英文资源完整。
RUN python2.7 -c "from pmdl.snowboy_pmdl import SnowboyPersonalEnroll, SnowboyTemplateCut" \
    && test -f resources/pmdl/zh/personal_enroll.res \
    && test -f resources/pmdl/zh/common.res \
    && test -f resources/pmdl/en/personal_enroll.res

ENTRYPOINT ["python2.7", "generate_pmdl.py"]
CMD ["-r1=/data/record1.wav", "-r2=/data/record2.wav", "-r3=/data/record3.wav", "-lang=zh", "-n=/data/my_wake.pmdl"]
