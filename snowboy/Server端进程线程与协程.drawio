        <mxCell id="handle-client" value="handle_client()&#10;每个连接调用一次&#10;鉴权后反复接收消息&#10;async for message...&#10;await AudioHandler&#10;或 await TextHandler" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#E4EFFD;strokeColor=#90B1D5;strokeWidth=1.5;">
