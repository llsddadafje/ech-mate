        <mxCell id="process-send" value="process_send_queue()&#10;create_task() 创建&#10;反复检查 ws_send_queue&#10;get_nowait() 取一项&#10;await websocket.send()&#10;队列空：sleep(0.1)" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#E4EFFD;strokeColor=#90B1D5;strokeWidth=1.5;">
          <mxGeometry x="525" y="875" width="320" height="255" as="geometry" />
        </mxCell>
        <mxCell id="create-send-task" parent="1" edge="1" source="handle-client" target="process-send" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#2871B8;strokeWidth=2;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.22;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="create-note" value="两个协程共用主线程；create_task() 不会新建线程。&#10;AudioHandler / TextHandler 是直接 await 的调用，也没有新建线程。" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#2871B8;fontStyle=0;align=center;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="175" y="1145" width="670" height="55" as="geometry" />
