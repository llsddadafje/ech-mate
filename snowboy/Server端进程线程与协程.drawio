        <mxCell id="audio-panel" value="" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#EEF8F2;strokeColor=#87B59B;strokeWidth=1.5;">
          <mxGeometry x="1640" y="325" width="600" height="560" as="geometry" />
        </mxCell>
        <mxCell id="audio-title" value="AudioSendThread · 1 个" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#238064;fontStyle=1;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1665" y="344" width="550" height="50" as="geometry" />
        </mxCell>
        <mxCell id="audio-source" value="main.py 中 tts_send_thread.start()&#10;threading.Thread(daemon=True)" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#238064;fontStyle=0;align=center;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1670" y="412" width="540" height="65" as="geometry" />
        </mxCell>
        <mxCell id="audio-work" value="run() 循环处理 PCM 音频&#10;audio_queue.get(timeout=1)&#10;拼接余量 → 按 40ms 音频切帧&#10;Opus 编码 → BinProtocol 打包&#10;ws_send_queue.put(bin_data)&#10;真正的网络发送由主线程发送协程执行" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#9ABDAB;strokeWidth=1.5;">
          <mxGeometry x="1670" y="510" width="540" height="225" as="geometry" />
        </mxCell>
        <mxCell id="audio-stop" value="stop_event 控制退出；main() 退出时 join()。&#10;40ms 是音频帧时长，不是网络发送定时周期。" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#238064;fontStyle=0;align=center;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1670" y="779" width="540" height="72" as="geometry" />
        </mxCell>
        <mxCell id="sdk-panel" value="" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#F7F2FC;strokeColor=#AD98C4;strokeWidth=1.5;">
          <mxGeometry x="990" y="940" width="1250" height="515" as="geometry" />
        </mxCell>
        <mxCell id="sdk-title" value="库内部的线程 · 仍在同一个 Python 进程内" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#8054B3;fontStyle=1;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1015" y="957" width="1200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="tts-sdk" value="TTS SDK WebSocket 接收线程&#10;本地 DashScope 1.26.7 已确认：&#10;Thread(target=self.ws.run_forever)&#10;创建为 daemon 并 start()&#10;首次 streaming_call() 按需建立连接&#10;在接收线程触发 on_data / on_complete&#10;→ _tts_on_data() / _tts_on_complete()&#10;回调是函数调用，不是各自再开一个线程" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#AD98C4;strokeWidth=1.5;">
          <mxGeometry x="1020" y="1030" width="600" height="375" as="geometry" />
        </mxCell>
        <mxCell id="native-threads" value="模型 / 数值库的内部线程&#10;PyTorch、BLAS 等可能维护内部线程池&#10;数量取决于环境、模型和运行配置&#10;没有在业务代码中逐个创建&#10;&#10;SDK 接收线程也随 TTS 连接生命周期变化&#10;因此系统观察到的总线程数&#10;不能固定写成 2 个或 7 个" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#AD98C4;strokeWidth=1.5;">
          <mxGeometry x="1660" y="1030" width="550" height="375" as="geometry" />
        </mxCell>
        <mxCell id="disabled" value="已创建对象但未启动的线程：TTSGenerateThread&#10;main.py 中 tts_generate_thread.start() / join() 均被注释&#10;tts_text_queue 也未用于当前聊天任务；文本入队代码被注释&#10;当前由聊天工作线程直接调用 tts_speech_stream(text_chunk)&#10;因此 TTSGenerateThread 不计入正在运行的线程数" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#F2F3F5;strokeColor=#ACB3BC;strokeWidth=1.5;">
          <mxGeometry x="100" y="1525" width="1050" height="220" as="geometry" />
        </mxCell>
        <mxCell id="shared" value="共享对象：ServiceManager&#10;audio_queue：SDK 回调 → AudioSendThread&#10;ws_send_queue：多个生产者 → 主线程的发送协程&#10;tts_text_queue：已创建，当前处理路径未启用&#10;queue.Queue / stop_event / VAD、ASR、TTS 服务对象本身都不是进程或线程" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#F0F7F5;strokeColor=#9FBEB3;strokeWidth=1.5;">
          <mxGeometry x="1190" y="1525" width="1050" height="220" as="geometry" />
        </mxCell>
        <mxCell id="count-note" value="正常运行中的应用显式线程：1 个主线程 + 1 个 AudioSendThread + 0～5 个聊天工作线程 = 2～7 个&#10;另外还有 SDK / 模型库内部线程；协程数量随客户端连接数变化。&#10;客户端程序与云端 LLM / TTS 服务位于该 Server 进程之外。图中不把云服务当作本地子进程。" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;">
          <mxGeometry x="80" y="1840" width="2200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="代码依据：Server/main.py:10、threads/task_manager.py:6、threads/audio_send_thread.py:8、ws_server.py:27/52/117、service_manager.py:56/74。&#10;库实现依据：AIChatServer 环境 dashscope/audio/tts_v2/speech_synthesizer.py:402/655/785；websockets/legacy/protocol.py:359。" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#60748A;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="80" y="1997" width="2200" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="echo-server-queue-flow" name="02 线程之间的队列与发送路径">
    <mxGraphModel dx="2400" dy="2100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Echo-Mate Server · 线程之间如何传数据" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#24374E;fontStyle=1;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
