        <mxCell id="producers-heading" value="生产者：按实际执行所在的线程分组" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#24374E;fontStyle=1;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
