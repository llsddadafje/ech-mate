          <mxGeometry x="1460" y="390" width="860" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sdk-producer-title" value="TTS SDK 接收线程 · 收到云端响应后调用回调" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#8054B3;fontStyle=1;align=center;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
