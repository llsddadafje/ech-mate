        <mxCell id="pcm-get" parent="1" edge="1" source="pcm-queue" target="audio-consumer" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#238064;strokeWidth=2.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
