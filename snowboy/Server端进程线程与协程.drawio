        </mxCell>
        <mxCell id="bin-put-label" value="put(bin_data)&#10;Opus + 协议头" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#238064;fontStyle=0;align=center;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1620" y="1050" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="main-json" parent="1" edge="1" source="main-producer" target="send-queue" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#2871B8;strokeWidth=2.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="940" />
              <mxPoint x="888.4" y="940" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="main-put-label" value="ASR / VAD JSON&#10;put() 只入队，不立即发送" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#2871B8;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="405" y="806" width="355" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pool-json" parent="1" edge="1" source="pool-producer" target="send-queue" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#BE6A25;strokeWidth=2.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.34;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pool-put-label" value="chat / function_call JSON&#10;聊天任务不等待发送协程完成&#10;发送协程也不等待整个聊天任务结束" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#BE6A25;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1100" y="790" width="375" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sdk-json" parent="1" edge="1" source="sdk-complete" target="send-queue" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#8054B3;strokeWidth=2.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.77;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1670" y="940" />
              <mxPoint x="1421.4" y="940" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sdk-put-label" value="tts/end JSON&#10;由完成回调直接入发送队列" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#8054B3;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1490" y="800" width="355" height="75" as="geometry" />
        </mxCell>
        <mxCell id="send-consumer" value="主线程 · process_send_queue(websocket)&#10;每个连接通过 asyncio.create_task() 创建&#10;get_nowait() → await websocket.send(data)&#10;队列空时 await asyncio.sleep(0.1)，之后重新检查" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#EEF5FE;strokeColor=#81A5CD;strokeWidth=1.5;">
          <mxGeometry x="790" y="1370" width="820" height="175" as="geometry" />
        </mxCell>
        <mxCell id="dequeue" parent="1" edge="1" source="send-queue" target="send-consumer" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#2871B8;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dequeue-label" value="取出并移除队头一项；连续处理队列中的数据&#10;100ms 是队列空时的等待时间，不是固定的发送周期" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#2871B8;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1230" y="1260" width="900" height="80" as="geometry" />
        </mxCell>
        <mxCell id="client" value="客户端进程（Server 进程之外）&#10;接收 JSON 或二进制音频" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#93A7BC;strokeWidth=1.5;">
          <mxGeometry x="940" y="1680" width="520" height="115" as="geometry" />
        </mxCell>
        <mxCell id="network-send" parent="1" edge="1" source="send-consumer" target="client" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#2871B8;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire-label" value="str → WebSocket 文本消息&#10;bytes → WebSocket 二进制消息" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#2871B8;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="1235" y="1580" width="920" height="70" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="执行关系&#10;• put/get 是同一进程内的线程安全队列操作；audio_queue 和 ws_send_queue 都不是独立线程。&#10;• TTS 完成通知与音频编码入队走不同路径，所以 tts/end 不保证排在最后音频包之后。send() 返回也不代表客户端播放完成。&#10;• 多个连接会各自创建接收 / 发送协程，但当前代码共用一个 ServiceManager 和发送队列；图中以单客户端说明。" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=left;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#C9D6E3;strokeWidth=1.5;">
          <mxGeometry x="80" y="1860" width="2240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="代码依据：service_manager.py:25–27/56–72/91–100；threads/audio_send_thread.py:21–45；ws_server.py:27–44/66。所有节点与箭头均可在 draw.io 中编辑。" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#60748A;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="80" y="2030" width="2240" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
