        <mxCell id="pool-source" value="ThreadPoolExecutor(max_workers=5)&#10;submit_task() 提交任务；空闲线程可复用" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#BE6A25;fontStyle=0;align=center;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
