        <mxCell id="sdk-data" value="on_data 回调&#10;_tts_on_data(data)&#10;收到 PCM bytes&#10;audio_queue.put(data)" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#AD98C4;strokeWidth=1.5;">
          <mxGeometry x="1890" y="490" width="400" height="155" as="geometry" />
        </mxCell>
        <mxCell id="pcm-queue" value="audio_queue · queue.Queue&#10;队列元素：云端返回的 PCM bytes&#10;每次 get() 移除一个音频块" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFF7D9;strokeColor=#CEB66C;strokeWidth=1.5;">
          <mxGeometry x="1870" y="785" width="440" height="120" as="geometry" />
