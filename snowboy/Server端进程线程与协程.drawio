        <mxCell id="audio-enqueue" parent="1" edge="1" source="audio-consumer" target="send-queue" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#238064;strokeWidth=2.8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;">
