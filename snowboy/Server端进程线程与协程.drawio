        <mxCell id="pcm-get-label" value="get(timeout=1)" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#238064;fontStyle=0;align=left;verticalAlign=middle;spacing=14;text;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry x="2115" y="931" width="215" height="45" as="geometry" />
