        <mxCell id="audio-consumer" value="AudioSendThread&#10;get PCM → 拼接余量 → 切帧&#10;encode_audio()：PCM → Opus&#10;pack_bin_frame()：协议头 + Opus&#10;ws_send_queue.put(bin_data)" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#EEF8F2;strokeColor=#87B59B;strokeWidth=1.5;">
          <mxGeometry x="1840" y="1015" width="500" height="230" as="geometry" />
        </mxCell>
        <mxCell id="send-queue" value="ws_send_queue · queue.Queue&#10;按实际入队顺序保存待发内容&#10;JSON 字符串 str：asr / vad / chat / tts / function_call&#10;二进制 bytes：BinProtocol 头 + Opus 音频" parent="1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#24374E;fontStyle=0;align=center;verticalAlign=middle;spacing=14;rounded=1;arcSize=12;fillColor=#FFF7D9;strokeColor=#CEB66C;strokeWidth=1.5;">
          <mxGeometry x="790" y="1035" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="tts-pcm" parent="1" edge="1" source="sdk-data" target="pcm-queue" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#8054B3;strokeWidth=2.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
