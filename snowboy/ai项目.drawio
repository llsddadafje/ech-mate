              <mxPoint x="890" y="605.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="H-footer" parent="1" vertex="1" value="Echo-Mate · 按工作区源码核对 · 更新于2026-10-09 · 节点与连线均可继续在draw.io中编辑" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2B4059;fontSize=12;fontStyle=0;fontFamily=Noto Sans CJK SC;">
          <mxGeometry x="40" y="1871" width="1710" height="22" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03 服务端识别与对话" id="server-processing">
    <mxGraphModel dx="1800" dy="1980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1980" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="H-title" parent="1" vertex="1" value="03 服务端识别与对话" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2B4059;fontSize=30;fontStyle=1;fontFamily=Noto Sans CJK SC;">
          <mxGeometry x="40" y="22" width="1710" height="48" as="geometry" />
        </mxCell>
        <mxCell id="H-subtitle" parent="1" vertex="1" value="40ms Opus 解包后由本地 FSMN / SenseVoiceSmall 识别；云端 qwen-turbo 处理意图与聊天，回复片段逐段进入 TTS。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2B4059;fontSize=15;fontStyle=0;fontFamily=Noto Sans CJK SC;">
          <mxGeometry x="40" y="78" width="1710" height="28" as="geometry" />
        </mxCell>
        <mxCell id="H-legend" parent="1" vertex="1" value="蓝色＝客户端 C++   绿色＝Python服务端   橙色＝云端模型   紫色＝队列   黄色＝条件   实线＝数据/调用   虚线＝事件/控制" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2B4059;fontSize=13;fontStyle=0;fontFamily=Noto Sans CJK SC;">
          <mxGeometry x="40" y="116" width="1710" height="24" as="geometry" />
        </mxCell>
        <mxCell id="L-server-local" parent="1" vertex="1" value="Python 服务端：本地处理、队列与线程池" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#EAF6EF;swimlaneFillColor=#FFFFFF;strokeColor=#77A88B;fontSize=16;fontColor=#30455D;fontStyle=1;fontFamily=Noto Sans CJK SC;align=left;spacingLeft=16;collapsible=0;container=1;">
          <mxGeometry x="50" y="160" width="1260" height="1790" as="geometry" />
        </mxCell>
        <mxCell id="L-server-asr-send" parent="1" vertex="1" value="服务端发送 ASR 文本" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#EAF6EF;swimlaneFillColor=#FFFFFF;strokeColor=#77A88B;fontSize=16;fontColor=#30455D;fontStyle=1;fontFamily=Noto Sans CJK SC;align=left;spacingLeft=16;collapsible=0;container=1;">
          <mxGeometry x="1310" y="680" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="L-client-asr" parent="1" vertex="1" value="C++ 客户端" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#EAF2FF;swimlaneFillColor=#FFFFFF;strokeColor=#7599C7;fontSize=16;fontColor=#30455D;fontStyle=1;fontFamily=Noto Sans CJK SC;align=left;spacingLeft=16;collapsible=0;container=1;">
          <mxGeometry x="1310" y="920" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="L-aliyun-llm" parent="1" vertex="1" value="阿里云百炼：云端模型" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#FFF0DB;swimlaneFillColor=#FFFFFF;strokeColor=#D0A061;fontSize=16;fontColor=#30455D;fontStyle=1;fontFamily=Noto Sans CJK SC;align=left;spacingLeft=16;collapsible=0;container=1;">
          <mxGeometry x="1310" y="1150" width="420" height="800" as="geometry" />
        </mxCell>
        <mxCell id="N-server-ws-binary" parent="L-server-local" vertex="1" value="&lt;b&gt;WebSocket 收到二进制消息&lt;/b&gt;&lt;br/&gt;handle_audio_message(msg)&lt;br/&gt;每包通常是一帧40ms音频&lt;br/&gt;先处理自定义应用协议" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="60" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-server-unpack" parent="L-server-local" vertex="1" value="&lt;b&gt;解包并检查协议&lt;/b&gt;&lt;br/&gt;unpack_bin_frame(msg)&lt;br/&gt;!HHI：8字节头 + Opus&lt;br/&gt;校验版本 / type=0 / is_vad" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="235" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-server-decode" parent="L-server-local" vertex="1" value="&lt;b&gt;Opus 解码为 PCM&lt;/b&gt;&lt;br/&gt;decode_audio(payload)&lt;br/&gt;np.frombuffer(..., dtype=np.int16)&lt;br/&gt;默认640采样值 / 1280字节" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="410" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-server-vad" parent="L-server-local" vertex="1" value="&lt;b&gt;本地 FSMN VAD&lt;/b&gt;&lt;br/&gt;独立VAD缓存；默认CPU&lt;br/&gt;累计200ms（3200采样）检测&lt;br/&gt;返回 0 / 1 / 2 / 3" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="585" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-vad-boundary-note" parent="L-server-local" vertex="1" value="&lt;b&gt;VAD 当前实现边界&lt;/b&gt;&lt;br/&gt;当前帧追加前检查 &amp;gt;15秒&lt;br/&gt;last_speech_pos &amp;gt; 800&lt;br/&gt;不等同实际语音持续时长" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="760" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-pcm-size-note" parent="L-server-local" vertex="1" value="&lt;b&gt;音频块与 VAD 切片不同&lt;/b&gt;&lt;br/&gt;网络默认40ms；VAD切200ms&lt;br/&gt;ASR独立保存本轮PCM&lt;br/&gt;ASR不是每200ms云端识别" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="935" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-vad-return" parent="L-server-local" vertex="1" value="&lt;b&gt;根据 VAD 返回值分支&lt;/b&gt;&lt;br/&gt;0：当前PCM加入ASR缓存&lt;br/&gt;1：语音结束，触发ASR&lt;br/&gt;2：无语音超时，不做ASR&lt;br/&gt;3：超过15秒，触发ASR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FFF6D9;strokeColor=#C8AE58;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="585" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-vad-no-speech" parent="L-server-local" vertex="1" value="&lt;b&gt;无语音消息入发送队列&lt;/b&gt;&lt;br/&gt;is_vad=true；约3秒无语音&lt;br/&gt;type=vad / state=no_speech&lt;br/&gt;入 ws_send_queue；不做ASR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="760" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-asr-buffer-note" parent="L-server-local" vertex="1" value="&lt;b&gt;ASR 结束分支的边界&lt;/b&gt;&lt;br/&gt;返回1/3时不追加当前帧&lt;br/&gt;ASR识别旧缓存并清空&lt;br/&gt;is_vad=true 后忽略本轮后续" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="1110" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-asr-buffer" parent="L-server-local" vertex="1" value="&lt;b&gt;独立 ASR PCM 缓存&lt;/b&gt;&lt;br/&gt;asr_add_audio_buffer(pcm_data)&lt;br/&gt;VAD返回0时加入当前PCM&lt;br/&gt;独立NumPy缓存，结束时识别" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="410" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-local-asr" parent="L-server-local" vertex="1" value="&lt;b&gt;本地 SenseVoiceSmall ASR&lt;/b&gt;&lt;br/&gt;FunASR；默认本地CPU&lt;br/&gt;识别完整ASR audio_buffer&lt;br/&gt;后处理文本；随后清空缓存" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="585" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-asr-result" parent="L-server-local" vertex="1" value="&lt;b&gt;本轮 ASR 识别文本&lt;/b&gt;&lt;br/&gt;正常识别结果 asr_res&lt;br/&gt;一条路径发送客户端&lt;br/&gt;另一条路径提交聊天任务" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="760" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-asr-json-queue" parent="L-server-asr-send" vertex="1" value="&lt;b&gt;ASR 消息入发送队列&lt;/b&gt;&lt;br/&gt;{&amp;quot;type&amp;quot;:&amp;quot;asr&amp;quot;,&amp;quot;text&amp;quot;:&amp;quot;...&amp;quot;}&lt;br/&gt;ws_send_queue 保存JSON文本&lt;br/&gt;发送协程取出后 websocket.send" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="65" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-client-asr-json" parent="L-client-asr" vertex="1" value="&lt;b&gt;客户端收到 ASR 文本&lt;/b&gt;&lt;br/&gt;handle_asr_message&lt;br/&gt;将识别文字交给应用&lt;br/&gt;通过事件进入thinking状态" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="50" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-task" parent="L-server-local" vertex="1" value="&lt;b&gt;线程池中的聊天任务&lt;/b&gt;&lt;br/&gt;submit_task(chat_start_task)&lt;br/&gt;输入：ASR识别文本&lt;br/&gt;TaskManager最多5个线程" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="935" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-intent-service" parent="L-server-local" vertex="1" value="&lt;b&gt;本地意图服务编排&lt;/b&gt;&lt;br/&gt;IntentService.detect_intent&lt;br/&gt;注册工具列表组成提示词&lt;br/&gt;独立LLMModel发非流式请求" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="935" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-intent-cloud" parent="L-aliyun-llm" vertex="1" value="&lt;b&gt;云端意图识别 qwen-turbo&lt;/b&gt;&lt;br/&gt;阿里云百炼兼容接口&lt;br/&gt;非流式返回function_call JSON&lt;br/&gt;与聊天使用独立模型对象" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FFF0DB;strokeColor=#D0A061;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="55" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-intent-branches" parent="L-server-local" vertex="1" value="&lt;b&gt;本地解析与处理意图&lt;/b&gt;&lt;br/&gt;continue_chat：继续&lt;br/&gt;exit_chat：发送chat/end&lt;br/&gt;其他函数：发送function_call&lt;br/&gt;之后均继续生成语音回复" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FFF6D9;strokeColor=#C8AE58;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="1110" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-intent-controls" parent="L-server-local" vertex="1" value="&lt;b&gt;控制消息入发送队列&lt;/b&gt;&lt;br/&gt;exit_chat → chat/end&lt;br/&gt;其他函数 → function_call&lt;br/&gt;入发送队列，可先于音频" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="1110" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-intent-history-note" parent="L-server-local" vertex="1" value="&lt;b&gt;函数结果历史结构限制&lt;/b&gt;&lt;br/&gt;history_list当前为嵌套列表&lt;br/&gt;ChatService预期逐项字典&lt;br/&gt;当前函数结果历史未加入" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="1285" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-history" parent="L-server-local" vertex="1" value="&lt;b&gt;聊天历史 messages 列表&lt;/b&gt;&lt;br/&gt;system + 历次user/assistant&lt;br/&gt;请求前加入当前user&lt;br/&gt;每轮请求携带已有历史" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="1285" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-request" parent="L-server-local" vertex="1" value="&lt;b&gt;聊天请求与生成器&lt;/b&gt;&lt;br/&gt;ChatService.generate_chat_response&lt;br/&gt;is_stream=True → answers生成器&lt;br/&gt;循环消费时发起云端请求" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="1285" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-cloud" parent="L-aliyun-llm" vertex="1" value="&lt;b&gt;云端聊天 qwen-turbo&lt;/b&gt;&lt;br/&gt;OpenAI兼容接口&lt;br/&gt;stream=True&lt;br/&gt;持续返回delta.content" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FFF0DB;strokeColor=#D0A061;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="295" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-delta" parent="L-server-local" vertex="1" value="&lt;b&gt;消费流式回复片段&lt;/b&gt;&lt;br/&gt;for chunk in stream&lt;br/&gt;yield delta → text_chunk&lt;br/&gt;片段即送TTS，同时累计全文" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="1460" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-full-text" parent="L-server-local" vertex="1" value="&lt;b&gt;同时累计完整回复&lt;/b&gt;&lt;br/&gt;full_text += delta&lt;br/&gt;不断拼接本轮回复&lt;br/&gt;无需等齐再提交TTS" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="1460" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-chat-assistant-history" parent="L-server-local" vertex="1" value="&lt;b&gt;流结束后保存 assistant&lt;/b&gt;&lt;br/&gt;保存assistant：full_text&lt;br/&gt;下一轮可携带完整回复&lt;br/&gt;语音提交不等待此步骤" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="440" y="1635" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N-tts-entry" parent="L-server-local" vertex="1" value="&lt;b&gt;流式 TTS 入口&lt;/b&gt;&lt;br/&gt;tts_speech_stream(text_chunk)&lt;br/&gt;逐段提交，流完tts_close()&lt;br/&gt;接续：云端PCM音频回调" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="860" y="1635" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="E-recv-unpack" parent="1" edge="1" source="N-server-ws-binary" target="N-server-unpack" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;endArrow=block;endFill=1;strokeColor=#526E8C;strokeWidth=1.5;fontColor=#526E8C;fontSize=12;fontFamily=Noto Sans CJK SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
