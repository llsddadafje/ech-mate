        <mxCell id="L-fin" parent="1" vertex="1" value="完成消息 / 状态切换" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#EAF2FF;swimlaneFillColor=#FFFFFF;strokeColor=#7599C7;fontSize=16;fontColor=#30455D;fontStyle=1;fontFamily=Noto Sans CJK SC;align=left;spacingLeft=16;collapsible=0;container=1;">
          <mxGeometry x="1315" y="175" width="445" height="1700" as="geometry" />
        </mxCell>
        <mxCell id="N-register" parent="L-rx" vertex="1" value="&lt;b&gt;构造时注册消息回调&lt;/b&gt;&lt;br/&gt;set_message_handler(bind(...))&lt;br/&gt;保存成员函数、this、_1、_2" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="70" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-library" parent="L-rx" vertex="1" value="&lt;b&gt;库取得完整消息指针&lt;/b&gt;&lt;br/&gt;msg = processor-&amp;gt;get_message()&lt;br/&gt;m_message_handler(hdl,msg)&lt;br/&gt;按位置：_1=hdl，_2=msg" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="260" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-member" parent="L-rx" vertex="1" value="&lt;b&gt;WebSocketClient::on_message&lt;/b&gt;&lt;br/&gt;msg 指向库创建的消息对象&lt;br/&gt;形参由库调用时传入" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="455" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-payload" parent="L-rx" vertex="1" value="&lt;b&gt;读取类型和消息内容&lt;/b&gt;&lt;br/&gt;get_opcode()：文本/二进制&lt;br/&gt;get_payload()：内容字节" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="645" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-lambda" parent="L-rx" vertex="1" value="&lt;b&gt;应用层回调 lambda&lt;/b&gt;&lt;br/&gt;SetMessageCallback → on_message_&lt;br/&gt;调用 app_handler.ws_msg_handle" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="835" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-handler" parent="L-rx" vertex="1" value="&lt;b&gt;WSHandler::ws_msg_handle&lt;/b&gt;&lt;br/&gt;二进制 → 解包/解码/入队&lt;br/&gt;文本JSON → 完成与状态标志" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1025" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-first" parent="L-rx" vertex="1" value="&lt;b&gt;本轮首条回复音频事件&lt;/b&gt;&lt;br/&gt;speaking_msg_received → eventQueue&lt;br/&gt;thinking → speaking&lt;br/&gt;事件在解包之前入队" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1215" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-bind-note" parent="L-rx" vertex="1" value="&lt;b&gt;bind 与参数来源&lt;/b&gt;&lt;br/&gt;_1/_2按调用实参位置对应&lt;br/&gt;构造时保存，收到消息时执行&lt;br/&gt;头文件声明不会产生消息数据" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1435" width="345" height="150" as="geometry" />
        </mxCell>
        <mxCell id="N-raw" parent="L-dec" vertex="1" value="&lt;b&gt;原始应用协议包&lt;/b&gt;&lt;br/&gt;输入：message.data() / size()&lt;br/&gt;输出：protocol_info / opus_data" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="70" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-unpack" parent="L-dec" vertex="1" value="&lt;b&gt;UnpackBinFrame&lt;/b&gt;&lt;br/&gt;至少8字节，按0/2/4偏移读取&lt;br/&gt;ntohs / ntohl 转换包头整数&lt;br/&gt;长度足够后从偏移8处取Opus" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="260" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-info" parent="L-dec" vertex="1" value="&lt;b&gt;解包结果&lt;/b&gt;&lt;br/&gt;protocol_info：版本、类型&lt;br/&gt;opus_data：不含应用包头&lt;br/&gt;解包这一步尚未解码音频" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="455" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-check" parent="L-dec" vertex="1" value="&lt;b&gt;检查版本和类型&lt;/b&gt;&lt;br/&gt;version 等于客户端配置&lt;br/&gt;type == 0；符合后继续" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FFF6D9;strokeColor=#C8AE58;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="650" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-decode" parent="L-dec" vertex="1" value="&lt;b&gt;AudioProcess::decode&lt;/b&gt;&lt;br/&gt;opus_decode：Opus → PCM&lt;br/&gt;实际返回采样数决定vector大小" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="845" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-pcm-queue" parent="L-dec" vertex="1" value="&lt;b&gt;PCM 播放队列&lt;/b&gt;&lt;br/&gt;addFrameToPlaybackQueue(pcm_data)&lt;br/&gt;playbackQueue 保存 int16_t 值" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1045" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-decode-note" parent="L-dec" vertex="1" value="&lt;b&gt;数据大小与实现边界&lt;/b&gt;&lt;br/&gt;40ms PCM：640值 / 1280字节&lt;br/&gt;Opus大小可变，应用包大小8+N&lt;br/&gt;960是每声道输出容量，非固定结果&lt;br/&gt;调用处当前未检查decode返回值" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1335" width="345" height="150" as="geometry" />
        </mxCell>
        <mxCell id="N-start" parent="L-out" vertex="1" value="&lt;b&gt;Speaking::Enter&lt;/b&gt;&lt;br/&gt;调用 startPlaying()&lt;br/&gt;与首帧入队顺序是异步的" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="70" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-open" parent="L-out" vertex="1" value="&lt;b&gt;Pa_OpenStream&lt;/b&gt;&lt;br/&gt;默认设备 / paInt16 / 本地采样率&lt;br/&gt;注册playCallback和this(userData)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="260" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-stream" parent="L-out" vertex="1" value="&lt;b&gt;Pa_StartStream&lt;/b&gt;&lt;br/&gt;启动音频输出流&lt;br/&gt;需要下一段音频时调用回调" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="450" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-play" parent="L-out" vertex="1" value="&lt;b&gt;playCallback&lt;/b&gt;&lt;br/&gt;从userData取AudioProcess对象&lt;br/&gt;output 指向 outputBuffer" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="640" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-front" parent="L-out" vertex="1" value="&lt;b&gt;取播放队列首帧&lt;/b&gt;&lt;br/&gt;front() / min(请求量,当前帧量)&lt;br/&gt;空队列或不足部分补静音" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="835" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-copy" parent="L-out" vertex="1" value="&lt;b&gt;填充音频输出缓冲区&lt;/b&gt;&lt;br/&gt;std::copy 复制PCM采样值&lt;br/&gt;pop/erase 已复制的数据&lt;br/&gt;return paContinue 保持流运行" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1035" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-speaker" parent="L-out" vertex="1" value="&lt;b&gt;设备输出声音&lt;/b&gt;&lt;br/&gt;PortAudio / 系统音频后端&lt;br/&gt;→ 声卡与扬声器" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1245" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-copy-note" parent="L-out" vertex="1" value="&lt;b&gt;出队与设备完成分开&lt;/b&gt;&lt;br/&gt;复制完成仅表示已提交输出数据&lt;br/&gt;设备还可能有待输出缓冲&lt;br/&gt;队列空时仍持续输出静音" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1445" width="345" height="150" as="geometry" />
        </mxCell>
        <mxCell id="N-json" parent="L-fin" vertex="1" value="&lt;b&gt;文本完成通知&lt;/b&gt;&lt;br/&gt;tts/state=end → tts_completed&lt;br/&gt;chat/dialogue=end → 对话结束标志" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="70" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-poll" parent="L-fin" vertex="1" value="&lt;b&gt;Speaking::Run 轮询检查&lt;/b&gt;&lt;br/&gt;每轮等待500ms再检查&lt;br/&gt;tts_completed &amp;amp;&amp;amp; 队列空&lt;br/&gt;成立后额外等待500ms" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="275" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-choose" parent="L-fin" vertex="1" value="&lt;b&gt;dialogue_completed？&lt;/b&gt;&lt;br/&gt;false → speaking_end&lt;br/&gt;true → dialogue_end" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FFF6D9;strokeColor=#C8AE58;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="485" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-events" parent="L-fin" vertex="1" value="&lt;b&gt;结束事件进入 eventQueue&lt;/b&gt;&lt;br/&gt;状态线程消费事件&lt;br/&gt;StateMachine::ChangeState" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="695" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-exit" parent="L-fin" vertex="1" value="&lt;b&gt;Speaking::Exit&lt;/b&gt;&lt;br/&gt;清播放队列，调用stopPlaying&lt;br/&gt;停止并join本状态检查线程" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="905" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-stop" parent="L-fin" vertex="1" value="&lt;b&gt;Pa_StopStream / 关闭流&lt;/b&gt;&lt;br/&gt;等待已提交的待输出缓冲区&lt;br/&gt;Pa_CloseStream / Pa_Terminate" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1115" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-next" parent="L-fin" vertex="1" value="&lt;b&gt;进入下一状态&lt;/b&gt;&lt;br/&gt;speaking_end → Listening&lt;br/&gt;dialogue_end → Idle&lt;br/&gt;先旧Exit，再新Enter" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1325" width="385" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-timing-note" parent="L-fin" vertex="1" value="&lt;b&gt;结束条件是当前程序的判断&lt;/b&gt;&lt;br/&gt;TTS完成消息可能先于尾部音频&lt;br/&gt;额外500ms不是设备完成通知&lt;br/&gt;停止流只等待已提交给流的数据" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="1535" width="385" height="150" as="geometry" />
        </mxCell>
        <mxCell id="E-e1" parent="1" edge="1" source="N-register" target="N-library" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;endArrow=block;endFill=1;strokeColor=#526E8C;strokeWidth=1.5;fontColor=#526E8C;fontSize=12;fontFamily=Noto Sans CJK SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E-e2" parent="1" edge="1" source="N-library" target="N-member" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;endArrow=block;endFill=1;strokeColor=#526E8C;strokeWidth=1.5;fontColor=#526E8C;fontSize=12;fontFamily=Noto Sans CJK SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
