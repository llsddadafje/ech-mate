        </mxCell>
        <mxCell id="H-subtitle" parent="1" vertex="1" value="网络回调解码入队，PortAudio回调输出；状态线程消费事件，Speaking线程检查本轮是否结束。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2B4059;fontSize=15;fontStyle=0;fontFamily=Noto Sans CJK SC;">
          <mxGeometry x="40" y="78" width="1710" height="28" as="geometry" />
        </mxCell>
        <mxCell id="H-legend" parent="1" vertex="1" value="蓝色＝客户端 C++   绿色＝Python服务端   橙色＝云端模型   紫色＝队列   黄色＝条件   实线＝数据/调用   虚线＝事件/控制" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2B4059;fontSize=13;fontStyle=0;fontFamily=Noto Sans CJK SC;">
          <mxGeometry x="40" y="116" width="1710" height="24" as="geometry" />
