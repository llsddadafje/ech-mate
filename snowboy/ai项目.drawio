        <mxCell id="L-rx" parent="1" vertex="1" value="网络回调 / 客户端封装" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#EAF2FF;swimlaneFillColor=#FFFFFF;strokeColor=#7599C7;fontSize=16;fontColor=#30455D;fontStyle=1;fontFamily=Noto Sans CJK SC;align=left;spacingLeft=16;collapsible=0;container=1;">
