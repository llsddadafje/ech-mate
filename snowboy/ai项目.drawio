          <mxGeometry x="55" y="630" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-sdk" parent="L-call" vertex="1" value="&lt;b&gt;SDK 接收云端结果&lt;/b&gt;&lt;br/&gt;音频数据 → on_data&lt;br/&gt;合成完成 → on_complete" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="820" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-close" parent="L-call" vertex="1" value="&lt;b&gt;所有文字提交结束&lt;/b&gt;&lt;br/&gt;循环结束后调用 tts_close()&lt;br/&gt;SDK streaming_complete()&lt;br/&gt;通知云端结束本次文字输入" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="1035" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-init" parent="L-call" vertex="1" value="&lt;b&gt;创建对象与合成请求分开&lt;/b&gt;&lt;br/&gt;启动时创建 TTSService / TTSModel&lt;br/&gt;listening 时登记本轮回调&lt;br/&gt;TTSGenerateThread.start 当前被注释&lt;br/&gt;chat_start_task 直接逐段提交文字" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="1245" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="N-data" parent="L-audio" vertex="1" value="&lt;b&gt;_tts_on_data(data)&lt;/b&gt;&lt;br/&gt;收到一块PCM字节&lt;br/&gt;回调块大小不保证等于一帧" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="65" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-audio-queue" parent="L-audio" vertex="1" value="&lt;b&gt;audio_queue&lt;/b&gt;&lt;br/&gt;PCM 块等待编码&lt;br/&gt;self.audio_queue.put(data)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="250" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-slice" parent="L-audio" vertex="1" value="&lt;b&gt;AudioSendThread.run&lt;/b&gt;&lt;br/&gt;拼接 remain_data&lt;br/&gt;按默认1280字节切完整PCM帧" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="435" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-encode" parent="L-audio" vertex="1" value="&lt;b&gt;Opus 编码&lt;/b&gt;&lt;br/&gt;encode_audio(frame_slice)&lt;br/&gt;默认输入一帧40ms PCM&lt;br/&gt;编码结果字节数可变" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="630" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-pack" parent="L-audio" vertex="1" value="&lt;b&gt;添加应用协议包头&lt;/b&gt;&lt;br/&gt;pack_bin_frame(...)&lt;br/&gt;struct.pack(&amp;quot;!HHI&amp;quot;,...) + Opus&lt;br/&gt;当前音频 type=0" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="825" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-ws-queue" parent="L-audio" vertex="1" value="&lt;b&gt;ws_send_queue&lt;/b&gt;&lt;br/&gt;二进制包和JSON共用队列&lt;br/&gt;已经入队的数据按先进先出取出" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F0EAFB;strokeColor=#A88AC6;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="1020" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-send" parent="L-audio" vertex="1" value="&lt;b&gt;process_send_queue()&lt;/b&gt;&lt;br/&gt;await websocket.send(data)&lt;br/&gt;bytes → 二进制；str → 文本" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="1215" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-client" parent="L-audio" vertex="1" value="&lt;b&gt;客户端接收&lt;/b&gt;&lt;br/&gt;完整WebSocket消息 → 回调&lt;br/&gt;解包、解码与播放见第05页" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF2FF;strokeColor=#7599C7;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="1410" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="N-complete" parent="L-end" vertex="1" value="&lt;b&gt;_tts_on_complete()&lt;/b&gt;&lt;br/&gt;云端合成完成回调&lt;br/&gt;直接写入 ws_send_queue" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="65" width="470" height="122" as="geometry" />
        </mxCell>
        <mxCell id="N-json" parent="L-end" vertex="1" value="&lt;b&gt;TTS 完成 JSON&lt;/b&gt;&lt;br/&gt;{&amp;quot;type&amp;quot;:&amp;quot;tts&amp;quot;,&amp;quot;state&amp;quot;:&amp;quot;end&amp;quot;}&lt;br/&gt;客户端设置 tts_completed=true" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EAF6EF;strokeColor=#77A88B;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="250" width="470" height="122" as="geometry" />
        </mxCell>
        <mxCell id="N-timing" parent="L-end" vertex="1" value="&lt;b&gt;完成通知与PCM经过不同路径&lt;/b&gt;&lt;br/&gt;PCM先入audio_queue，再编码入发送队列&lt;br/&gt;完成通知直接入发送队列&lt;br/&gt;tts/end 可能先于最后一个音频包&lt;br/&gt;合成完成不等于客户端播放完成" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="475" width="470" height="155" as="geometry" />
        </mxCell>
        <mxCell id="N-protocol" parent="L-end" vertex="1" value="&lt;b&gt;BinProtocol：8字节应用包头&lt;/b&gt;&lt;br/&gt;偏移0：版本，2字节&lt;br/&gt;偏移2：类型，2字节&lt;br/&gt;偏移4：负载长度，4字节&lt;br/&gt;偏移8：Opus负载，N字节&lt;br/&gt;正常消息内容总长 = 8 + N" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="725" width="470" height="165" as="geometry" />
        </mxCell>
        <mxCell id="N-units" parent="L-end" vertex="1" value="&lt;b&gt;默认一帧音频大小&lt;/b&gt;&lt;br/&gt;16000Hz × 40ms = 640采样值&lt;br/&gt;单声道16位PCM：640 × 2 = 1280字节&lt;br/&gt;这是编码前PCM大小&lt;br/&gt;Opus负载长度由编码结果决定&lt;br/&gt;WebSocket自身帧头由库处理" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="985" width="470" height="165" as="geometry" />
        </mxCell>
        <mxCell id="N-tail" parent="L-end" vertex="1" value="&lt;b&gt;末帧的当前实现&lt;/b&gt;&lt;br/&gt;不足一帧只保留 remain_data&lt;br/&gt;没有合成结束时补齐发送的逻辑&lt;br/&gt;残余拼接后未统一清空&lt;br/&gt;此图描述源码现状，未修改业务代码" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F4F6FA;strokeColor=#BDC7D3;strokeWidth=1.5;fontColor=#24364E;fontSize=15;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="55" y="1255" width="470" height="150" as="geometry" />
        </mxCell>
